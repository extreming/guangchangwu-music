.page {
  padding: 36rpx 32rpx 0;
}

.title {
  font-size: 68rpx;
  font-weight: 700;
  color: #064E3B;
  line-height: 1.2;
}

.sub {
  margin-top: 12rpx;
  margin-bottom: 28rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.empty {
  background: #FFFFFF;
  border: 6rpx solid #064E3B;
  border-radius: 28rpx;
  padding: 36rpx 28rpx;
}

.empty-title {
  font-size: 56rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.45;
}

.song {
  background: #FFFFFF;
  border: 6rpx solid #064E3B;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.song.playing {
  background: #E5F6EC;
}

.song-flag {
  display: inline-block;
  background: #064E3B;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.song-title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.35;
}

.song-meta {
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.song-go {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #064E3B;
}

.keep {
  margin-top: 12rpx;
  background: #FFF3C4;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.45;
}
